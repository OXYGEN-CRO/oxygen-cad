    "inputs": [
      {"id": "beam_length", "kind": "envelope", "description": "Benchmark beam length", "value": 80, "unit": "mm", "provenance": "examples/cantilever.json numerical fixture", "parameter": "length"},
      {"id": "load", "kind": "load", "description": "Benchmark force magnitude; native study specifies face and direction", "value": 10, "unit": "N", "provenance": "examples/cantilever.json numerical fixture"},
      {"id": "payload", "kind": "payload", "description": "Real payload remains unspecified"},
      {"id": "interface", "kind": "interface", "description": "Real attachment interfaces remain unspecified"},
      {"id": "budget", "kind": "budget", "description": "Purchasing budget remains unspecified"},
      {"id": "idealization", "kind": "assumption", "description": "Ideal fixed-end numerical cantilever benchmark; no physical validation", "provenance": "examples/cantilever.json analytical verification fixture"}
    ],
    "links": [
      {"id": "fit", "description": "Stay within the benchmark X envelope", "requirement_id": "length_limit", "parameter_refs": ["length"], "input_refs": ["beam_length"]},
      {"id": "response", "description": "Check deflection under the explicitly supplied benchmark load", "requirement_id": "deflection", "study_id": "default", "input_refs": ["load"]}
    ]
  }
