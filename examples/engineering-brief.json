{
  "name": "Engineering brief benchmark",
  "parameters": {"length": {"value": 80, "unit": "mm"}},
  "features": [
    {"id": "beam_profile", "type": "profile", "plane": "YZ", "width": 10, "height": 4},
    {"id": "beam", "type": "extrude", "profile": "beam_profile", "distance": "$length"}
  ],
  "material": {
    "name": "Numerical benchmark material",
    "youngs_modulus_mpa": 200000,
    "poisson_ratio": 0.3,
    "density_g_cm3": 7.85,
    "source": "examples/cantilever.json analytical verification fixture; test inputs, not a production material certificate"
  },
  "study": {
    "fixed_faces": ["part:xmin"],
    "forces": [{"face": "part:xmax", "vector_n": [0, 0, -10]}],
    "mesh_size_mm": 3,
    "refinement_steps": 3,
    "assumptions_confirmed": true,
    "stress_probe_mm": [40, 0, 1.5]
  },
  "requirements": [
    {"id": "length_limit", "kind": "max_dimension", "axis": "X", "value": 90},
    {"id": "deflection", "kind": "max_displacement", "value": 0.2, "study_id": "default"}
